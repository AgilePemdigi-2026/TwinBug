APP_NAME=TwinBug
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TIMEOUT=60
ML_SERVICE_TOP_K=5
ML_SERVICE_MAX_CANDIDATES=500
ML_SERVICE_MODEL=paraphrase-multilingual-MiniLM-L12-v2
ML_SERVICE_API_KEY=

# DETECTION_IMAGE_MATCH_THRESHOLD: minimum image_score (1 - hamming_distance/64)
# to include a candidate purely on image similarity. Default 0.90 (distance <= 6).
DETECTION_IMAGE_MATCH_THRESHOLD=0.90

# DETECTION_IMAGE_MAX_CANDIDATES: cap on image-only candidates fetched from
# the same application before Hamming comparison.
DETECTION_IMAGE_MAX_CANDIDATES=500

# DETECTION_UNIFORMITY_VARIANCE_THRESHOLD: pixel variance below this value
# means the image is nearly uniform and yields no hash.
DETECTION_UNIFORMITY_VARIANCE_THRESHOLD=10.0

# ML_API_KEY is used by the ML service itself to validate X-API-Key.
# Leave empty to disable authentication on the ML side.
ML_API_KEY=

VISION_SERVICE_URL=https://api.openai.com/v1/chat/completions
VISION_SERVICE_KEY=
VISION_SERVICE_MODEL=gpt-4o-mini
VISION_SERVICE_TIMEOUT=60

# OTP Resend Settings
# OTP_RESEND_COOLDOWN: minimum seconds between OTP resend requests per email. Default 60s.
OTP_RESEND_COOLDOWN=60

# OTP_MAX_RESENDS_PER_HOUR: max OTP resend attempts per email per hour. Default 5.
OTP_MAX_RESENDS_PER_HOUR=5

# OTP_RESEND_LIMIT_PER_IP: max OTP resend attempts per IP per hour. Default 5.
OTP_RESEND_LIMIT_PER_IP=5
